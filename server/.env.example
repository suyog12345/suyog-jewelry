# Server Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/suyog-jewelry?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Account (Read directly by seed script and auth)
ADMIN_EMAIL=admin@suyogjewelry.com
ADMIN_PASSWORD=your_strong_admin_password_here

# WhatsApp Owner Number (with country code, no + sign)
WHATSAPP_NUMBER=919752009399

# Frontend URLs for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://www.suyogjewelry.com,https://suyogjewelry.com

# Cookie Settings (lax + secure for same-domain; none + secure for separate domains like vercel & render)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Contact Email (for receiving contact form submissions)
CONTACT_EMAIL=suyogsinnarkar@gmail.com
