{
  "rewrites": [
    {
      "source": "/products/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|Applebot).*"
        }
      ],
      "destination": "https://api.suyogjewelry.com/products/:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "https://suyog-jewelry.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.suyogjewelry.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://api.suyogjewelry.com/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}